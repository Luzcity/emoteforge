{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmoteForge",
  "version": "0.1.0",
  "identifier": "dev.emoteforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EmoteForge — FiveM エモートスタジオ",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.png"],
    "resources": [
      "../catalog/catalog.json",
      "../catalog/dump_index.json",
      "../schema/emote.schema.json"
    ]
  }
}
