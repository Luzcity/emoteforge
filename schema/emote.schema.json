{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmoteSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "clips", "loop", "upperBodyOnly", "movementType", "meta"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "resource 内で一意な識別子。小文字英数字とアンダースコアのみ。"
    },
    "displayName": {
      "type": "string",
      "description": "UI 表示用の名前（日本語可）。"
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/clipRef" }
    },
    "loop": { "type": "boolean" },
    "upperBodyOnly": { "type": "boolean" },
    "prop": { "$ref": "#/definitions/prop" },
    "facial": { "$ref": "#/definitions/facial" },
    "movementType": {
      "type": "string",
      "enum": ["stationary", "walkable", "actionLoop"]
    },
    "meta": { "$ref": "#/definitions/meta" }
  },
  "definitions": {
    "clipRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dict", "clip"],
      "properties": {
        "source": { "type": "string", "enum": ["builtin", "ycd"], "default": "builtin" },
        "dict": { "type": "string", "description": "既存 GTA V のアニメ辞書名。" },
        "clip": { "type": "string", "description": "辞書内のクリップ名。" },
        "blendIn": { "type": "number", "default": 1.0 },
        "blendOut": { "type": "number", "default": 1.0 },
        "duration": { "type": "integer", "default": -1, "description": "ms。-1 でクリップ長。" },
        "playbackRate": { "type": "number", "default": 1.0 },
        "flags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "bone", "offset", "rot"],
      "properties": {
        "model": { "type": "string" },
        "bone": { "type": "integer" },
        "offset": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "rot": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
      }
    },
    "facial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dict", "clip"],
      "properties": {
        "dict": { "type": "string" },
        "clip": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "schemaVersion"],
      "properties": {
        "source": { "type": "string" },
        "schemaVersion": { "type": "integer" }
      }
    }
  }
}
