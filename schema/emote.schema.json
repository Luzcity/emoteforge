{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmoteSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "clips", "loop", "upperBodyOnly", "prop", "facial", "movementType", "meta"],
  "properties": {
    "name": {
      "type": "string",
      "description": "resource 内で一意な識別子。小文字英数字とアンダースコアのみ。"
    },
    "displayName": {
      "type": "string",
      "description": "UI 表示用の名前（日本語可）。"
    },
    "clips": {
      "type": "array",
      "description": "順に再生するクリップ列（1 つ以上）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "dict", "clip", "blendIn", "blendOut", "duration", "playbackRate", "flags"],
        "properties": {
          "source": { "type": "string", "enum": ["builtin", "ycd"] },
          "dict": { "type": "string", "description": "既存 GTA V のアニメ辞書名。" },
          "clip": { "type": "string", "description": "辞書内のクリップ名。" },
          "blendIn": { "type": "number" },
          "blendOut": { "type": "number" },
          "duration": { "type": "integer", "description": "ms。-1 でクリップ長。" },
          "playbackRate": { "type": "number" },
          "flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "loop": { "type": "boolean" },
    "upperBodyOnly": { "type": "boolean" },
    "prop": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "bone", "offset", "rot"],
          "properties": {
            "model": { "type": "string" },
            "bone": { "type": "integer" },
            "offset": { "type": "array", "items": { "type": "number" } },
            "rot": { "type": "array", "items": { "type": "number" } }
          }
        },
        { "type": "null" }
      ]
    },
    "facial": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["dict", "clip"],
          "properties": {
            "dict": { "type": "string" },
            "clip": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "movementType": {
      "type": "string",
      "enum": ["stationary", "walkable", "actionLoop"]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "schemaVersion"],
      "properties": {
        "source": { "type": "string" },
        "schemaVersion": { "type": "integer" }
      }
    }
  }
}
